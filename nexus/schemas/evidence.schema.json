{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS Evidence Intake Record",
  "description": "One manually documented public-source observation. Passing this schema validates shape only, not truth or market demand.",
  "type": "object",
  "required": [
    "problem_statement",
    "source_url",
    "source_title",
    "collected_at"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "affected_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "geography": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "collected_at": {
      "type": "string",
      "format": "date"
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "evidence_class": {
      "enum": [
        "fact",
        "hypothesis",
        "inference"
      ]
    },
    "independent_source_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "willingness_to_pay_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "competing_solutions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "verified",
        "disputed",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
