{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "source_url",
    "source_title",
    "collected_at",
    "evidence_class",
    "claim"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "evidence_class": {
      "enum": [
        "fact",
        "hypothesis",
        "inference"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "independent_source_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "verified",
        "disputed",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
